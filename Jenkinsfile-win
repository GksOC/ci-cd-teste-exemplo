pipeline {
    agent any

    tools { nodejs "nodejs26" }

    stages {
        stage("Clonar e iniciar o hub de leitura") {
            steps {
                bat '''
                    if exist hub-de-leitura-integrado rmdir /s /q hub-de-leitura-integrado
                    git clone https://github.com/EBAC-QE/hub-de-leitura-integrado
                '''
                dir("hub-de-leitura-integrado") {
                    bat '''
                        call npm install
                        start /B npm start > nul 2>&1
                    '''
                }
            }
        }

        stage("Instalar dependencias do teste") {
            steps {
                // Executa direto na raiz do projeto já clonado pelo Jenkins SCM
                bat "call npm install"
            }
        }

        stage("Executar os testes automatizados") {
            steps {
                bat "call npm run cy:run"
            }
        }
    }

    post {
        success{
			echo 'Build finalizada com sucesso!'
		}
		failure{
			echo 'Houve um erro durante a build'
		}
		always {
            bat "taskkill /F /IM node.exe || exit 0"
			echo 'Arquivando artefatos - caso houver erros'
			dir('ci-cd-teste-exemplo'){
				archiveArtifacts artifacts: 'cypress/screenshots/**/*.*,cypress/videos/**/*.*', allowEmptyArchive: true
				allure includeProperties: false, jdk: '', results: [[path: 'allure-report']]
			}
		}
    }
    
}